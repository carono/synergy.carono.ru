LMS_LOGIN=info@example.ru
LMS_PASSWORD=your-password
LMS_OUTPUT_DIR=./downloads
LMS_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36"
LMS_REQUIRED_WATCH_MINUTES=30
LMS_STATE_FILE=./state.json
# Каталог с установленным Playwright — нужен ./bin/cookies для прохождения DDoS-Guard
LMS_PLAYWRIGHT_DIR=/path/to/playwright-install
LMS_NODE_BIN=node
