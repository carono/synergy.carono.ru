#!/usr/bin/env php
<?php

declare(strict_types=1);

use Carono\LmsParser\Client;
use Carono\LmsParser\DownloadQueue;
use Carono\LmsParser\Downloader;
use Carono\LmsParser\Logger;
use Carono\LmsParser\Parser;
use Carono\LmsParser\Runner;
use Carono\LmsParser\Scorm;
use Carono\LmsParser\Secret;
use Carono\LmsParser\State;

$root = dirname(__DIR__);
require $root.'/vendor/autoload.php';

// .env
$envPath = $root.'/.env';
if (is_file($envPath)) {
    foreach (file($envPath, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
        if (str_starts_with(ltrim($line), '#')) continue;
        if (!str_contains($line, '=')) continue;
        [$k, $v] = explode('=', $line, 2);
        $k = trim($k);
        $v = trim($v, " \t\n\r\0\x0B\"'");
        if ($k !== '' && getenv($k) === false) {
            putenv("$k=$v");
            $_ENV[$k] = $v;
        }
    }
}

// CLI args
$opts = getopt('', [
    'semester:', 'discover-only', 'no-watch', 'minutes:',
    'max-disciplines:', 'max-lessons:', 'discipline:',
    'retake::', 'no-retake', 'tabs', 'redo', 'threads:', 'pid-file:', 'help',
]);
if (isset($opts['help'])) {
    echo "Использование: ./bin/parse [--semester=N] [--discover-only] [--no-watch] [--minutes=N]\n";
    echo "  --semester=N             обработать конкретный семестр (по умолчанию — текущий)\n";
    echo "  --discover-only          только вывести структуру, ничего не качать\n";
    echo "  --no-watch               качать видео, но не отмечать как просмотренные\n";
    echo "  --minutes=N              сколько 'просмотренных' минут отправлять в SCORM (default 30)\n";
    echo "  --max-disciplines=N      обработать не более N дисциплин (для тестов)\n";
    echo "  --max-lessons=N          обработать не более N уроков в каждой дисциплине\n";
    echo "  --discipline=str|id      обработать только дисциплины, чей title содержит str (или с указанным id)\n";
    echo "  --retake[=auto|force|off] как работать с вкладкой «Пересдача» на странице дисциплины:\n";
    echo "                           auto  (по умолчанию) — брать её, если есть задолженность или заблокированные уроки\n";
    echo "                           force — всегда брать, если вкладка вообще есть\n";
    echo "                           off   — игнорировать, работать только с «Текущими»\n";
    echo "  --no-retake              то же, что --retake=off\n";
    echo "  --tabs                   вместе с --discover-only: открыть каждую дисциплину и показать её вкладки материалов\n";
    echo "  --threads=N              сколько файлов качать одновременно (default 4, 1 — последовательно)\n";
    echo "  --pid-file=PATH          записать свой PID (для остановки прогона без pkill по шаблону)\n";
    echo "  --redo                   не доверять отметкам done в state.json и открыть уроки заново\n";
    echo "                           (нужно, если прошлый прогон забирал не все типы материалов; файлы на диске не перекачиваются)\n";
    exit(0);
}

$login = (string)(getenv('LMS_LOGIN') ?: '');
$password = (string)(getenv('LMS_PASSWORD') ?: '');
$outputDir = (string)(getenv('LMS_OUTPUT_DIR') ?: $root.'/downloads');
$userAgent = (string)(getenv('LMS_USER_AGENT') ?: 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36');
$watchMinutes = (int)($opts['minutes'] ?? getenv('LMS_REQUIRED_WATCH_MINUTES') ?: 30);
$emulateWatch = !isset($opts['no-watch']);
$semesterFilter = isset($opts['semester']) ? (int)$opts['semester'] : null;

$threads = (int)($opts['threads'] ?? getenv('LMS_THREADS') ?: 4);
if ($threads < 1 || $threads > 32) {
    fwrite(STDERR, "Неверное значение --threads: $threads (ожидается 1..32)\n");
    exit(2);
}

$retakeMode = Runner::RETAKE_AUTO;
if (isset($opts['no-retake'])) {
    $retakeMode = Runner::RETAKE_OFF;
} elseif (isset($opts['retake'])) {
    $retakeMode = $opts['retake'] === false ? Runner::RETAKE_FORCE : (string)$opts['retake'];
}
if (!in_array($retakeMode, [Runner::RETAKE_AUTO, Runner::RETAKE_FORCE, Runner::RETAKE_OFF], true)) {
    fwrite(STDERR, "Неверное значение --retake: $retakeMode (ожидается auto|force|off)\n");
    exit(2);
}

if ($login === '' || $password === '') {
    fwrite(STDERR, "Не задан LMS_LOGIN / LMS_PASSWORD (положите .env рядом с composer.json или экспортируйте в окружение)\n");
    exit(2);
}

if (!str_starts_with($outputDir, '/') && !preg_match('~^[A-Za-z]:~', $outputDir)) {
    $outputDir = $root.'/'.ltrim($outputDir, './');
}

// PID пишет сам процесс: $! из шелла указывает на обёртку setsid, а не на парсер,
// и остановка по нему не доходит до дочерних загрузок.
if (isset($opts['pid-file'])) {
    file_put_contents((string)$opts['pid-file'], (string)getmypid());
}

$logger = new Logger();
$logger->info("Output:  $outputDir");
$logger->info("User:    ".Secret::maskLogin($login));
$logger->info("Watch:   {$watchMinutes} мин".($emulateWatch ? '' : ' (только скачивание)'));
$logger->info("Retake:  $retakeMode");
$logger->info("Потоков: $threads");
if ($semesterFilter !== null) {
    $logger->info("Семестр: $semesterFilter");
}

$cookieFile = $root.'/cookies.json';
$stateFile = (string)(getenv('LMS_STATE_FILE') ?: $root.'/state.json');

$client = new Client($login, $password, $cookieFile, $userAgent, $logger);
$parser = new Parser();
$downloader = new Downloader($logger, $userAgent, $cookieFile);
$scorm = new Scorm($client, $logger);
$state = new State($stateFile);

if (isset($opts['discover-only'])) {
    $client->login();
    $html = $client->getHtml('/student/up');
    $semesters = $parser->semesters($html);

    $showTabs = isset($opts['tabs']);

    foreach ($semesters as $s) {
        if ($semesterFilter !== null && $s['number'] !== $semesterFilter) {
            continue;
        }
        $mark = $s['current'] ? ' (текущий)' : '';
        $debt = $s['debt'] ? ' [задолженность'.($s['debtCount'] > 0 ? ': '.$s['debtCount'] : '').']' : '';
        echo "\nСеместр {$s['number']}{$mark}{$debt} — ".count($s['disciplines'])." дисциплин\n";
        foreach ($s['disciplines'] as $d) {
            $flag = $d['debt'] ? '!' : ' ';
            $control = $d['control'] !== null ? " — {$d['control']}" : '';
            echo "  $flag [{$d['id']}] {$d['title']}$control\n";
            $state->setDisciplineMeta((string)$d['id'], [
                'title' => $d['title'],
                'semester' => $s['number'],
                'slug' => \Carono\LmsParser\Slug::make($d['title']),
                'debt' => $d['debt'],
                'control' => $d['control'],
            ]);

            if (!$showTabs) {
                continue;
            }
            try {
                $discHtml = $client->getHtml($d['contentsUrl']);
            } catch (\Throwable $e) {
                echo "      вкладки: ошибка — ".$e->getMessage()."\n";
                continue;
            }
            $tabs = $parser->disciplineTabs($discHtml);
            if (empty($tabs)) {
                echo "      вкладки: нет (единый набор материалов)\n";
                continue;
            }
            foreach ($tabs as $t) {
                $lessons = [];
                if ($t['retake']) {
                    try {
                        $lessons = $parser->disciplineLessons(
                            $t['active'] ? $discHtml : $client->getHtml($t['url'])
                        )['lessons'];
                    } catch (\Throwable) {
                        // не критично — просто не покажем счётчик
                    }
                } elseif ($t['active']) {
                    $lessons = $parser->disciplineLessons($discHtml)['lessons'];
                }
                $count = $lessons === []
                    ? ''
                    : sprintf(' — уроков: %d, заблокировано: %d',
                        count($lessons),
                        count(array_filter($lessons, fn($l) => $l['locked'])),
                    );
                printf("      %s %-12s %s%s\n",
                    $t['active'] ? '*' : ' ',
                    $t['label'],
                    $t['url'],
                    $count,
                );
            }
        }
    }
    exit(0);
}

$maxDisciplines = isset($opts['max-disciplines']) ? (int)$opts['max-disciplines'] : null;
$maxLessons = isset($opts['max-lessons']) ? (int)$opts['max-lessons'] : null;
$disciplineFilter = isset($opts['discipline']) ? (string)$opts['discipline'] : null;

$queue = new DownloadQueue($logger, $root.'/bin/download-worker', $threads);

// Челлендж DDoS-Guard грузит страницу через тот же канал, что и закачки, и на полном
// параллелизме не успевал пройти. Поэтому на время обновления сессии канал освобождается.
$client->useDownloadHooks(
    static fn() => $queue->pause(),
    static fn() => $queue->resume(),
);

$runner = new Runner(
    $client, $parser, $downloader, $scorm, $state, $logger,
    $outputDir, $watchMinutes, $emulateWatch,
    $maxDisciplines, $maxLessons, $disciplineFilter, $retakeMode,
    isset($opts['redo']),
    $queue,
);
$runner->run($semesterFilter);
