#!/usr/bin/env php
<?php

declare(strict_types=1);

use Carono\LmsParser\Client;
use Carono\LmsParser\Logger;
use Carono\LmsParser\Schedule;

$root = dirname(__DIR__);
require $root.'/vendor/autoload.php';

$envPath = $root.'/.env';
if (is_file($envPath)) {
    foreach (file($envPath, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
        if (str_starts_with(ltrim($line), '#')) continue;
        if (!str_contains($line, '=')) continue;
        [$k, $v] = explode('=', $line, 2);
        $k = trim($k);
        $v = trim($v, " \t\n\r\0\x0B\"'");
        if ($k !== '' && getenv($k) === false) {
            putenv("$k=$v");
            $_ENV[$k] = $v;
        }
    }
}

$opts = getopt('', ['calendar', 'classes', 'dump', 'help']);
if (isset($opts['help'])) {
    echo "Использование: ./bin/session [--calendar] [--classes] [--dump]\n";
    echo "  без флагов     текущий период + ближайшая сессия + занятия за её период\n";
    echo "  --calendar     только календарный график (/students/calend)\n";
    echo "  --classes      только расписание занятий за ближайшую сессию\n";
    echo "  --dump         сохранить HTML-ответы в logs/ (для отладки)\n";
    exit(0);
}

$login = (string)(getenv('LMS_LOGIN') ?: '');
$password = (string)(getenv('LMS_PASSWORD') ?: '');
$userAgent = (string)(getenv('LMS_USER_AGENT') ?: 'Mozilla/5.0');
if ($login === '' || $password === '') {
    fwrite(STDERR, "Не задан LMS_LOGIN / LMS_PASSWORD (см. .env)\n");
    exit(2);
}

$logger = new Logger();
$client = new Client($login, $password, $root.'/cookies.json', $userAgent, $logger);
$client->login();

$schedule = new Schedule();
$today = new DateTimeImmutable('today');
$dump = isset($opts['dump']);

$calendarHtml = $client->getHtml('/students/calend');
if ($dump) {
    @mkdir($root.'/logs', 0775, true);
    file_put_contents($root.'/logs/students_calend.html', $calendarHtml);
}

$events = $schedule->calendar($calendarHtml);
if (!$events) {
    fwrite(STDERR, "Календарный график не распознан (страница /students/calend изменилась?)\n");
    exit(1);
}

$showCalendar = isset($opts['calendar']) || (!isset($opts['classes']));
$showClasses  = isset($opts['classes'])  || (!isset($opts['calendar']));

if ($showCalendar) {
    $current = $schedule->findCurrent($events, $today);
    $upcoming = $schedule->findUpcomingSession($events, $today);

    echo "Сегодня: ".$today->format('d.m.Y').PHP_EOL.PHP_EOL;

    if ($current) {
        echo "СЕЙЧАС: семестр {$current['semester']}, {$current['event']} ("
            .$current['start']->format('d.m.Y')." — ".$current['end']->format('d.m.Y').")\n";
    }
    if ($upcoming) {
        $marker = ($upcoming['start'] <= $today && $today <= $upcoming['end']) ? ' ← идёт' : '';
        echo "Сессия: семестр {$upcoming['semester']}, {$upcoming['event']} ("
            .$upcoming['start']->format('d.m.Y')." — ".$upcoming['end']->format('d.m.Y').")".$marker."\n";
    }
    echo PHP_EOL;

    echo "Календарный график:\n";
    $course = null;
    foreach ($events as $e) {
        if ($e['course'] !== null && $e['course'] !== $course) {
            $course = $e['course'];
            echo "  {$course} курс\n";
        }
        $mark = '';
        if ($e['start'] <= $today && $today <= $e['end']) {
            $mark = ' ← СЕЙЧАС';
        } elseif ($e['end'] < $today) {
            $mark = ' (прошло)';
        }
        printf(
            "    сем %d  %s — %s  %s%s\n",
            $e['semester'],
            $e['start']->format('d.m.Y'),
            $e['end']->format('d.m.Y'),
            $e['event'],
            $mark
        );
    }
    echo PHP_EOL;
}

if ($showClasses) {
    $upcoming = $schedule->findUpcomingSession($events, $today);
    if (!$upcoming) {
        echo "Ближайшая сессия не найдена в календарном графике.\n";
        exit(0);
    }

    $from = $upcoming['start']->modify('-7 days')->format('d.m.Y');
    $to   = $upcoming['end']->modify('+7 days')->format('d.m.Y');
    echo "Расписание занятий за период сессии (запрос {$from} — {$to}):\n";

    $tabs = [
        'Аудиторные занятия' => '/schedule/academ',
        'Вебинары'           => '/schedule/webinar',
        'Консультации'       => '/schedule/consultation',
        'Тьюториалы'         => '/schedule/tutorplan',
        'Онлайн пересдачи'   => '/schedule/retake',
    ];

    foreach ($tabs as $title => $path) {
        $resp = $client->post($path, [
            'headers' => [
                'Referer' => 'https://lms.synergy.ru'.$path,
                'X-Requested-With' => 'XMLHttpRequest',
            ],
            'form_params' => [
                'mySchedule' => '1',
                'dateFrom' => $from,
                'dateTo' => $to,
                'doSrch' => '1',
                'time_check' => '1',
                'discipline_check' => '1',
                'place_check' => '1',
                'type_check' => '1',
                'teacher_check' => '1',
            ],
        ]);
        $html = (string)$resp->getBody();
        if ($dump) {
            file_put_contents($root.'/logs/sched_'.basename($path).'.html', $html);
        }
        $rows = $schedule->classes($html);
        echo "\n  ## {$title} ({$path}) — событий: ".count($rows)."\n";
        foreach ($rows as $i => $cells) {
            echo '    '.($i + 1).') '.implode(' | ', $cells)."\n";
        }
    }
}
